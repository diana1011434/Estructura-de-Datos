1) Evaluar expresiones matemáticas en notación
posfija (postfix).

// Importa la clase Stack que permite usar estructuras tipo pila (LIFO)
import java.util.Stack;

// Clase principal del programa
public class EvaluadorExpresion {

    // Método que evalúa una expresión en notación postfija
    public static int evaluar(String expresion) {

        // Se crea una pila para almacenar números enteros
        Stack<Integer> pila = new Stack<>();

        // Divide la expresión en partes usando el espacio como separador
        // Ejemplo: "5 3 + 2 *" → ["5","3","+","2","*"]
        String[] tokens = expresion.split(" ");

        // Recorre cada elemento (token) de la expresión
        for (String token : tokens) {

            // Verifica si el token es un número (uno o más dígitos)
            if (token.matches("\\d+")) {

                // Convierte el texto a entero y lo guarda en la pila
                pila.push(Integer.parseInt(token));

            } else {

                // Si no es número, entonces es un operador
                // Se sacan los últimos dos números ingresados (LIFO)
                int b = pila.pop(); // último valor ingresado
                int a = pila.pop(); // valor anterior

                // Evalúa qué operación realizar
                switch (token) {

                    case "+":
                        // Suma y guarda el resultado en la pila
                        pila.push(a + b);
                        break;

                    case "-":
                        // Resta respetando el orden (a - b)
                        pila.push(a - b);
                        break;

                    case "*":
                        // Multiplicación
                        pila.push(a * b);
                        break;

                    case "/":
                        // División entera
                        pila.push(a / b);
                        break;
                }
            }
        }

        // Al finalizar solo queda un valor en la pila: el resultado final
        return pila.pop();
    }


    // Método principal donde inicia el programa
    public static void main(String[] args) {

        // Expresión en notación postfija
        // Equivale a: (5 + 3) * 2
        String expresion = "5 3 + 2 *";

        // Llama al método evaluar y muestra el resultado
        System.out.println("Resultado: " + evaluar(expresion));
    }
}



2) Implementar la funcionalidad de deshacer (undo)
y rehacer (redo) en un editor de texto.

import java.util.Stack; 
// Importa la clase Stack que permite trabajar con pilas (LIFO).

// Definición de la clase principal
public class EditorTexto {

    // Pila para guardar acciones realizadas (historial)
    private Stack<String> acciones = new Stack<>();

    // Pila para guardar acciones deshechas (rehacer)
    private Stack<String> rehacer = new Stack<>();

    // Método para escribir texto
    public void escribir(String texto) {
        acciones.push(texto);  
        // Guarda el texto en la pila de acciones realizadas

        rehacer.clear();       
        // Si escribimos algo nuevo, se borra el historial de rehacer
        // porque ya cambió la secuencia de acciones
    }

    // Método DESHACER (Undo)
    public String deshacer() {

        if (!acciones.isEmpty()) {  
            // Verifica que existan acciones para deshacer

            String texto = acciones.pop();  
            // Quita el último elemento escrito (LIFO)

            rehacer.push(texto);  
            // Guarda ese elemento en la pila de rehacer

            return "Deshacer: " + texto;  
            // Retorna mensaje indicando qué se deshizo
        }

        return "Nada que deshacer"; 
        // Si la pila está vacía
    }

    // Método REHACER (Redo)
    public String rehacer() {

        if (!rehacer.isEmpty()) {  
            // Verifica que exista algo para rehacer

            String texto = rehacer.pop();  
            // Toma el último elemento deshecho

            acciones.push(texto);  
            // Lo vuelve a colocar en acciones

            return "Rehacer: " + texto;  
            // Retorna mensaje indicando qué se rehizo
        }

        return "Nada que rehacer";  
        // Si no hay elementos
    }

    // Método principal (inicio del programa)
    public static void main(String[] args) {

        EditorTexto editor = new EditorTexto();
        // Se crea un objeto del editor

        editor.escribir("Hola");
        // Guarda "Hola" en la pila acciones

        editor.escribir("Mundo");
        // Guarda "Mundo" encima de "Hola"

        System.out.println(editor.deshacer());
        // Elimina "Mundo" y lo pasa a la pila rehacer
        // Salida: Deshacer: Mundo

        System.out.println(editor.rehacer());
        // Recupera "Mundo" desde rehacer
        // Salida: Rehacer: Mundo
    }
}
